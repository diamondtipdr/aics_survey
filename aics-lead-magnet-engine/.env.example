# ============================================
# OpenAI / AI Provider (OpenAI-compatible)
# ============================================
OPENAI_API_KEY=
# Use any OpenAI-compatible endpoint (OpenAI, Azure, Ollama, etc.)
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ============================================
# MySQL Database (Moodle bridge)
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=aics_leads

# ============================================
# Google Sheets (analytics backup)
# ============================================
# Full JSON content of your Google Service Account key
GOOGLE_SERVICE_ACCOUNT_KEY=
# The ID of the Google Sheet (from the URL)
GOOGLE_SHEET_ID=

# ============================================
# Mailgun Email API
# ============================================
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# ============================================
# Application
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# Logging & Audit
# ============================================
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_FILE_PATH=/app/logs/app.log
AUDIT_ENABLED=true