{
  "name": "aics-lead-magnet-engine",
  "version": "1.0.0",
  "description": "Microservice that processes assessment form responses, generates AI-powered PDF reports, and dispatches them via Mailgun",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc --project tsconfig.build.json && copyfiles -u 1 \"src/templates/**/*\" dist/ && npm run build:spa",
    "build:spa": "vite build",
    "start": "node dist/server.js",
    "dev": "concurrently \"ts-node-dev --respawn --transpile-only src/server.ts\" \"vite\"",
    "test": "jest --config jest.config.ts",
    "test:watch": "jest --config jest.config.ts --watch",
    "test:coverage": "jest --config jest.config.ts --coverage",
    "lint": "eslint src/ --ext .ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.4",
    "axios": "^1.7.2",
    "concurrently": "^10.0.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.1",
    "form-data": "^4.0.0",
    "googleapis": "^140.0.1",
    "helmet": "^7.1.0",
    "lucide-react": "^0.378.0",
    "mysql2": "^3.10.1",
    "puppeteer": "^22.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^10.0.0",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "copyfiles": "^2.4.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3",
    "vite": "^8.1.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
