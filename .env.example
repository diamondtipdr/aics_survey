# ============================================
# OpenAI / AI Provider (OpenAI-compatible)
# ============================================
OPENAI_API_KEY=
# Use any OpenAI-compatible endpoint (OpenAI, Azure, Ollama, etc.)
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ============================================
# MySQL Database (Moodle bridge)
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=aics_app
DB_PASSWORD=
DB_ROOT_PASSWORD=rootpassword
DB_NAME=aics_leads

# ============================================
# Google Sheets (analytics backup)
# ============================================
# Path to your Google Service Account JSON key file
# Place the JSON file at ./secrets/google-service-account.json
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./secrets/google-service-account.json
# The ID of the Google Sheet (from the URL)
GOOGLE_SHEET_ID=

# ============================================
# Mailgun Email API
# ============================================
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# ============================================
# Moodle API (protects /api/v1/moodle/* endpoints)
# ============================================
MOODLE_API_KEY=

# ============================================
# Security
# ============================================
# Comma-separated origins allowed by CORS, or * for all (dev only)
CORS_ORIGIN=*
# Max requests per 15-min window per IP (production: 100)
RATE_LIMIT_MAX=100

# ============================================
# Application
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# Logging & Audit
# ============================================
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_FILE_PATH=/app/logs/app.log
AUDIT_ENABLED=true